{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Treehouse",
  "version": "0.2.0",
  "identifier": "dev.treehouse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Treehouse",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["resources/agent/*"]
  }
}
